          'deviceCount',
          'updatedAt'
        ]) &&
        (('propertyCount' in request.resource.data) ? request.resource.data.propertyCount : 0) >= 0 &&
        (('deviceCount' in request.resource.data) ? request.resource.data.deviceCount : 0) >= 0 &&
        (
          // Property create increment
          (
            (('propertyCount' in request.resource.data) ? request.resource.data.propertyCount : 0) == (('propertyCount' in resource.data) ? resource.data.propertyCount : 0) + 1 &&
            (('deviceCount' in request.resource.data) ? request.resource.data.deviceCount : 0) == (('deviceCount' in resource.data) ? resource.data.deviceCount : 0)
          ) ||
          // Property delete decrement
          (
            (('propertyCount' in request.resource.data) ? request.resource.data.propertyCount : 0) == ((('propertyCount' in resource.data) ? resource.data.propertyCount : 0) > 0 ? (('propertyCount' in resource.data) ? resource.data.propertyCount : 0) - 1 : 0) &&
            (('deviceCount' in request.resource.data) ? request.resource.data.deviceCount : 0) == (('deviceCount' in resource.data) ? resource.data.deviceCount : 0)
          ) ||
          // Device create increment
          (
            (('deviceCount' in request.resource.data) ? request.resource.data.deviceCount : 0) == (('deviceCount' in resource.data) ? resource.data.deviceCount : 0) + 1 &&
            (('propertyCount' in request.resource.data) ? request.resource.data.propertyCount : 0) == (('propertyCount' in resource.data) ? resource.data.propertyCount : 0)
          ) ||
          // Device delete decrement
          (
            (('deviceCount' in request.resource.data) ? request.resource.data.deviceCount : 0) == ((('deviceCount' in resource.data) ? resource.data.deviceCount : 0) > 0 ? (('deviceCount' in resource.data) ? resource.data.deviceCount : 0) - 1 : 0) &&
            (('propertyCount' in request.resource.data) ? request.resource.data.propertyCount : 0) == (('propertyCount' in resource.data) ? resource.data.propertyCount : 0)
          )
        );

