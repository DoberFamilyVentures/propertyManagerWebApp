        (('createdByUserId' in resource.data) && resource.data.createdByUserId == request.auth.uid) ||
        (('teamMemberEmail' in resource.data) && resource.data.teamMemberEmail == getUserEmail()) ||
        (('email' in resource.data) && resource.data.email == getUserEmail())
      );
      allow create, update, delete: if false;
