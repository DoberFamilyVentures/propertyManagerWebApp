        propertySpaceMatchesProperty(request.resource.data) &&
        request.resource.data.accountId == resource.data.accountId &&
        request.resource.data.propertyId == resource.data.propertyId &&
        request.resource.data.createdBy == resource.data.createdBy &&
        request.resource.data.createdAt == resource.data.createdAt &&
        request.resource.data.source == resource.data.source &&
