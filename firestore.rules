rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function getUserEmail() {
      return request.auth.token.email;
    }

    function callerMembershipId(accountId) {
      return accountId + '_' + request.auth.uid;
    }

    function hasMembership(accountId) {
      return exists(/databases/$(database)/documents/accountMemberships/$(callerMembershipId(accountId)));
    }

    function membershipData(accountId) {
      return get(/databases/$(database)/documents/accountMemberships/$(callerMembershipId(accountId))).data;
    }

    function callerUserDocPath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    function callerUserDocExists() {
      return exists(callerUserDocPath());
    }

    function callerUserData() {
      return get(callerUserDocPath()).data;
    }

    function hasLegacyAccountLink(accountId) {
      return isAuthenticated() &&
        callerUserDocExists() &&
        (
          request.auth.uid == accountId ||
          (
            ('accountId' in callerUserData()) &&
            callerUserData().accountId == accountId
          )
        );
    }

    function hasLegacyManageRole(accountId) {
      return hasLegacyAccountLink(accountId) &&
        !((('isTeamMemberAccount' in callerUserData()) && callerUserData().isTeamMemberAccount == true)) &&
        (
          request.auth.uid == accountId ||
          (('isAccountOwner' in callerUserData()) && callerUserData().isAccountOwner == true) ||
          (('role' in callerUserData()) && ['admin', 'property_manager', 'assistant_manager'].hasAny([callerUserData().role]))
        );
    }

    function isActiveMember(accountId) {
      return isAuthenticated() &&
        hasMembership(accountId) &&
        (
          !('status' in membershipData(accountId)) ||
          membershipData(accountId).status == 'active'
        );
    }

    function hasAnyRole(accountId, roles) {
      return isActiveMember(accountId) &&
        membershipData(accountId).roles.hasAny(roles);
    }

    function canReadAccount(accountId) {
      return isActiveMember(accountId) || hasLegacyAccountLink(accountId);
    }

    function canManageAccount(accountId) {
      return hasAnyRole(accountId, ['account_owner', 'admin', 'manager']) ||
        hasLegacyManageRole(accountId);
    }

    function isHomeownerAccountOwner(accountId) {
      return hasAnyRole(accountId, ['account_owner']) ||
        (
          hasLegacyAccountLink(accountId) &&
          !((('isTeamMemberAccount' in callerUserData()) && callerUserData().isTeamMemberAccount == true)) &&
          (
            request.auth.uid == accountId ||
            (('isAccountOwner' in callerUserData()) && callerUserData().isAccountOwner == true)
          )
        );
    }

    function canManagePropertyKnowledge(accountId) {
      return hasAnyRole(accountId, [
          'account_owner',
          'admin',
          'manager',
          'property_manager',
          'assistant_manager'
        ]) ||
        hasLegacyManageRole(accountId);
    }

    function accountOwnerDocPath(accountId) {
      return /databases/$(database)/documents/users/$(accountId);
    }

    function accountOwnerDocExists(accountId) {
      return exists(accountOwnerDocPath(accountId));
    }

    function accountOwnerData(accountId) {
      return get(accountOwnerDocPath(accountId)).data;
    }

    function familyAccountDocPath(accountId) {
      return /databases/$(database)/documents/familyAccounts/$(accountId);
    }

    function familyAccountExists(accountId) {
      return exists(familyAccountDocPath(accountId));
    }

    function familyAccountData(accountId) {
      return get(familyAccountDocPath(accountId)).data;
    }

    function familyAccountDataAfter(accountId) {
      return getAfter(familyAccountDocPath(accountId)).data;
    }

    function currentPropertyCount(accountId) {
      return familyAccountExists(accountId) && ('propertyCount' in familyAccountData(accountId))
        ? familyAccountData(accountId).propertyCount
        : 0;
    }

    function currentDeviceCount(accountId) {
      return familyAccountExists(accountId) && ('deviceCount' in familyAccountData(accountId))
        ? familyAccountData(accountId).deviceCount
        : 0;
    }

    // Firestore cannot import the shared package. Keep this narrow mirror aligned
    // with @maintley/entitlements and cover it with emulator parity tests.
    function planLimit(plan, limitId) {
      return limitId == 'properties'
		? (plan == 'homeowner'
		  ? 1
		  : (plan == 'homeowner_plus'
		    ? 5
		    : (plan == 'property' ? 7 : (plan == 'portfolio' ? 15 : 0))))
        : (limitId == 'devices'
		  ? (['homeowner', 'homeowner_plus', 'property', 'portfolio'].hasAny([plan]) ? 999 : 0)
          : 0);
    }

    function planHasCapability(plan, capabilityId) {
      return capabilityId == 'properties.manage'
		? ['homeowner', 'homeowner_plus', 'property', 'portfolio'].hasAny([plan])
        : (capabilityId == 'residents.manage'
          ? ['property', 'portfolio'].hasAny([plan])
          : (capabilityId == 'property_groups.manage'
			? ['homeowner_plus', 'property', 'portfolio'].hasAny([plan])
            : (capabilityId == 'team.manage'
              ? ['property', 'portfolio'].hasAny([plan])
              : (capabilityId == 'team.advanced'
                ? plan == 'portfolio'
                : (capabilityId == 'recurring_tasks.use'
				  ? ['homeowner', 'homeowner_plus', 'property', 'portfolio'].hasAny([plan])
                  : (capabilityId == 'property_types.business' || capabilityId == 'rental_management.use'
				    ? ['property', 'portfolio'].hasAny([plan])
                    : false))))));
    }

    function clientInitialSubscriptionIsSafe(data) {
      return !('maintley_role' in data) &&
        (!('subscription' in data) ||
        (
          data.subscription.status == 'active' &&
          ['homeowner', 'guest', 'team', 'tenant'].hasAny([data.subscription.plan]) &&
          !('stripeSubscriptionId' in data.subscription) &&
          !('stripeCustomerId' in data.subscription) &&
          (
            !('pendingCheckoutPlan' in data.subscription) ||
			['homeowner_plus', 'property', 'portfolio'].hasAny([
              data.subscription.pendingCheckoutPlan
            ])
          )
        ));
    }

    function clientSubscriptionUpdateIsSafe() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['subscription']) ||
        (
          ('subscription' in resource.data) &&
          ('subscription' in request.resource.data) &&
          request.resource.data.subscription.diff(resource.data.subscription).affectedKeys().hasOnly([
            'pendingCheckoutPlan',
            'pendingCheckoutStartedAt',
            'promoCode'
          ])
        ) ||
        (
          !('subscription' in resource.data) &&
          clientInitialSubscriptionIsSafe(request.resource.data)
        );
    }

    function subscriptionHasCurrentEntitlement(subscription) {
      return subscription.status == 'active' ||
        (
          subscription.status == 'trial' &&
          (
            !('trialEndsAt' in subscription) ||
            subscription.trialEndsAt == null ||
            subscription.trialEndsAt > (request.time.toMillis() / 1000)
          )
        );
    }

    function baseEntitledPlanForAccount(accountId) {
      return accountOwnerDocExists(accountId) &&
        ('subscription' in accountOwnerData(accountId)) &&
        subscriptionHasCurrentEntitlement(accountOwnerData(accountId).subscription)
        ? accountOwnerData(accountId).subscription.plan
        : 'homeowner';
    }

    function hasActiveProjectedBundle(accountId, bundleId) {
      return familyAccountExists(accountId) &&
        ('effectiveEntitlementProjection' in familyAccountData(accountId)) &&
        ('activeBundleIds' in familyAccountData(accountId).effectiveEntitlementProjection) &&
        familyAccountData(accountId).effectiveEntitlementProjection.activeBundleIds.hasAny([bundleId]) &&
        (
          !('bundleExpirationsMs' in familyAccountData(accountId).effectiveEntitlementProjection) ||
          !(bundleId in familyAccountData(accountId).effectiveEntitlementProjection.bundleExpirationsMs) ||
          familyAccountData(accountId).effectiveEntitlementProjection.bundleExpirationsMs[bundleId] > request.time.toMillis()
        );
    }

    function entitledPlanForAccount(accountId) {
      return baseEntitledPlanForAccount(accountId) == 'homeowner' &&
        hasActiveProjectedBundle(accountId, 'homeowner_plus')
        ? 'homeowner_plus'
        : baseEntitledPlanForAccount(accountId);
    }

    function hasRecurringTaskConfiguration(data) {
      return ('isRecurring' in data) && data.isRecurring == true;
    }

    function hasActiveProjectedRecurringBundle(accountId) {
      let projection = familyAccountData(accountId).effectiveEntitlementProjection;
      let activeBundleIds = projection.activeBundleIds;
      return familyAccountExists(accountId) &&
        ('effectiveEntitlementProjection' in familyAccountData(accountId)) &&
        ('activeBundleIds' in projection) &&
        (
          (
            activeBundleIds.hasAny(['homeowner_plus']) &&
            (
              !('bundleExpirationsMs' in projection) ||
              !('homeowner_plus' in projection.bundleExpirationsMs) ||
              projection.bundleExpirationsMs.homeowner_plus > request.time.toMillis()
            )
          ) ||
		  (
            activeBundleIds.hasAny(['property']) &&
            (
              !('bundleExpirationsMs' in projection) ||
              !('property' in projection.bundleExpirationsMs) ||
              projection.bundleExpirationsMs.property > request.time.toMillis()
            )
          ) ||
          (
            activeBundleIds.hasAny(['portfolio']) &&
            (
              !('bundleExpirationsMs' in projection) ||
              !('portfolio' in projection.bundleExpirationsMs) ||
              projection.bundleExpirationsMs.portfolio > request.time.toMillis()
            )
          )
        );
    }

    function recurringTaskWriteIsEntitled(accountId, data) {
      return !hasRecurringTaskConfiguration(data) ||
        planHasCapability(baseEntitledPlanForAccount(accountId), 'recurring_tasks.use') ||
        hasActiveProjectedRecurringBundle(accountId);
    }

    function maxPropertiesForAccount(accountId) {
      let baseLimit = planLimit(baseEntitledPlanForAccount(accountId), 'properties');
      return hasActiveProjectedBundle(accountId, 'portfolio') && baseLimit < 15
        ? 15
        : (hasActiveProjectedBundle(accountId, 'property') && baseLimit < 7
          ? 7
		  : baseLimit);
    }

    function maxDevicesForAccount(accountId) {
      let baseLimit = planLimit(baseEntitledPlanForAccount(accountId), 'devices');
      return (
		hasActiveProjectedBundle(accountId, 'homeowner_plus') ||
		hasActiveProjectedBundle(accountId, 'property') ||
        hasActiveProjectedBundle(accountId, 'portfolio')
      ) && baseLimit < 999
        ? 999
        : baseLimit;
    }

    function hasPropertyCounterCreateIncrement(accountId) {
      return familyAccountExists(accountId) &&
        familyAccountDataAfter(accountId).propertyCount == currentPropertyCount(accountId) + 1 &&
        familyAccountDataAfter(accountId).propertyCount <= maxPropertiesForAccount(accountId);
    }

    function hasPropertyCounterDeleteDecrement(accountId) {
      return familyAccountExists(accountId) &&
        familyAccountDataAfter(accountId).propertyCount == (currentPropertyCount(accountId) > 0
          ? currentPropertyCount(accountId) - 1
          : 0);
    }

    function hasDeviceCounterCreateIncrement(accountId) {
      return familyAccountExists(accountId) &&
        familyAccountDataAfter(accountId).deviceCount == currentDeviceCount(accountId) + 1 &&
        familyAccountDataAfter(accountId).deviceCount <= maxDevicesForAccount(accountId);
    }

    function hasDeviceCounterDeleteDecrement(accountId) {
      return familyAccountExists(accountId) &&
        familyAccountDataAfter(accountId).deviceCount == (currentDeviceCount(accountId) > 0
          ? currentDeviceCount(accountId) - 1
          : 0);
    }

    // Resident/tenant access and maintenance requests start on Property.
    function hasActiveManagedInvitePlan(accountId) {
      return accountOwnerDocExists(accountId) &&
        (
          planHasCapability(baseEntitledPlanForAccount(accountId), 'residents.manage') ||
          hasActiveProjectedBundle(accountId, 'property') ||
          hasActiveProjectedBundle(accountId, 'portfolio')
        );
    }

    function hasActiveCoreSubscription(accountId) {
      return accountOwnerDocExists(accountId) &&
        ('subscription' in accountOwnerData(accountId)) &&
        (
          accountOwnerData(accountId).subscription.status == 'active' ||
          (
            accountOwnerData(accountId).subscription.status == 'trial' &&
            (
              !('trialEndsAt' in accountOwnerData(accountId).subscription) ||
              accountOwnerData(accountId).subscription.trialEndsAt == null ||
              accountOwnerData(accountId).subscription.trialEndsAt > (request.time.toMillis() / 1000)
            )
          )
        );
    }

    function hasCorePlanForResources(accountId) {
      return accountOwnerDocExists(accountId) &&
        planHasCapability(baseEntitledPlanForAccount(accountId), 'properties.manage');
    }

    // Plan gates mirror PLAN_FEATURE_MATRIX.md: property groups start at Property.
    function canUsePropertyGroups(accountId) {
      return accountOwnerDocExists(accountId) &&
        (
		  planHasCapability(baseEntitledPlanForAccount(accountId), 'property_groups.manage') ||
		  hasActiveProjectedBundle(accountId, 'property') ||
          hasActiveProjectedBundle(accountId, 'portfolio')
        );
    }

    // Property has simple team management; Portfolio has advanced team roles and property assignments.
    function canUseSimpleTeam(accountId) {
      return accountOwnerDocExists(accountId) &&
        (
          planHasCapability(baseEntitledPlanForAccount(accountId), 'team.manage') ||
          hasActiveProjectedBundle(accountId, 'property') ||
          hasActiveProjectedBundle(accountId, 'portfolio')
        );
    }

    function canUseAdvancedTeam(accountId) {
      return accountOwnerDocExists(accountId) &&
        (
          planHasCapability(baseEntitledPlanForAccount(accountId), 'team.advanced') ||
          hasActiveProjectedBundle(accountId, 'portfolio')
        );
    }

    function isSimpleTeamMemberData(data) {
      return (!('role' in data) || data.role == 'admin') &&
        (!('linkedProperties' in data) || data.linkedProperties.size() == 0) &&
        (!('groupId' in data) || data.groupId == null || data.groupId == '');
    }

    function canWriteTeamMemberData(accountId, data) {
      return canUseSimpleTeam(accountId) &&
        (canUseAdvancedTeam(accountId) || isSimpleTeamMemberData(data));
    }

    // A downgrade may stop team expansion, but it must not trap retained
    // relationship records. Account managers can still maintain basic profile
    // context without changing access, roles, groups, or property assignments.
    function isRetainedTeamMemberProfileUpdate() {
      return request.resource.data.diff(resource.data).changedKeys().hasOnly([
        'firstName',
        'lastName',
        'title',
        'phone',
        'address',
        'image',
        'notes',
        'files',
        'updatedAt'
      ]);
    }

    function propertyWriteRespectsResidentPlan(accountId) {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['tenants']) ||
        hasActiveManagedInvitePlan(accountId);
    }

    function propertyCreateRespectsResidentPlan(accountId) {
      return !('tenants' in request.resource.data) ||
        request.resource.data.tenants.size() == 0 ||
        hasActiveManagedInvitePlan(accountId);
    }

    function canUseBusinessPropertyTypes(accountId) {
      return planHasCapability(baseEntitledPlanForAccount(accountId), 'property_types.business') ||
        hasActiveProjectedBundle(accountId, 'property') ||
        hasActiveProjectedBundle(accountId, 'portfolio');
    }

    function canUseRentalManagement(accountId) {
      return planHasCapability(baseEntitledPlanForAccount(accountId), 'rental_management.use') ||
        hasActiveProjectedBundle(accountId, 'property') ||
        hasActiveProjectedBundle(accountId, 'portfolio');
    }

    function normalizedPropertyType(data) {
      return !('propertyType' in data) ||
        ['residential', 'Single Family', 'Single-Family'].hasAny([data.propertyType])
        ? 'residential'
        : (['multi_unit', 'Multi-Family'].hasAny([data.propertyType]) ? 'multi_unit' : data.propertyType);
    }

    function propertyCreateRespectsTaxonomyPlan(accountId) {
      return (
        normalizedPropertyType(request.resource.data) == 'residential' ||
        canUseBusinessPropertyTypes(accountId)
      ) && (
        !(('isRental' in request.resource.data) && request.resource.data.isRental == true) ||
        canUseRentalManagement(accountId)
      ) && propertyClassificationMatchesType(request.resource.data);
    }

    function propertyClassificationMatchesType(data) {
      return !('propertyClassification' in data) ||
        (normalizedPropertyType(data) == 'residential' &&
          ['single_family', 'condo', 'townhome', 'apartment'].hasAny([data.propertyClassification])) ||
        (normalizedPropertyType(data) == 'multi_unit' &&
          ['duplex', 'triplex', 'fourplex', 'apartment_building', 'other_multi_unit'].hasAny([data.propertyClassification])) ||
        (normalizedPropertyType(data) == 'commercial' &&
          ['commercial_suite', 'standalone_commercial', 'multi_tenant_commercial', 'mixed_use', 'industrial_warehouse', 'other_commercial'].hasAny([data.propertyClassification]));
    }

    function propertyUpdateRespectsTaxonomyPlan(accountId) {
      return propertyClassificationMatchesType(request.resource.data) &&
        (canUseBusinessPropertyTypes(accountId) ||
        (
          normalizedPropertyType(request.resource.data) == normalizedPropertyType(resource.data) &&
          (
            !(('isRental' in request.resource.data) && request.resource.data.isRental == true) ||
            (('isRental' in resource.data) && resource.data.isRental == true)
          )
        ));
    }

    function unitWriteRespectsResidentPlan(accountId) {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['occupants']) ||
        hasActiveManagedInvitePlan(accountId);
    }

    function unitCreateRespectsResidentPlan(accountId) {
      return !('occupants' in request.resource.data) ||
        request.resource.data.occupants.size() == 0 ||
        hasActiveManagedInvitePlan(accountId);
    }

    function isAccountOwnerOrAdmin(accountId) {
      return canManageAccount(accountId);
    }

    function callerHasTaskManagementRole(accountId) {
      return hasLegacyAccountLink(accountId) &&
        (!hasMembership(accountId) || isActiveMember(accountId)) &&
        callerUserDocExists() &&
        ('role' in callerUserData()) &&
        ['maintenance_lead', 'maintenance'].hasAny([callerUserData().role]);
    }

    function callerLinkedTeamMemberHasTaskManagementRole(accountId) {
      return callerUserDocExists() &&
        (!hasMembership(accountId) || isActiveMember(accountId)) &&
        ('teamMemberId' in callerUserData()) &&
        exists(/databases/$(database)/documents/teamMembers/$(callerUserData().teamMemberId)) &&
        (
          (
            'accountId' in get(/databases/$(database)/documents/teamMembers/$(callerUserData().teamMemberId)).data &&
            get(/databases/$(database)/documents/teamMembers/$(callerUserData().teamMemberId)).data.accountId == accountId
          ) ||
          (
            'userId' in get(/databases/$(database)/documents/teamMembers/$(callerUserData().teamMemberId)).data &&
            get(/databases/$(database)/documents/teamMembers/$(callerUserData().teamMemberId)).data.userId == accountId
          )
        ) &&
        ('role' in get(/databases/$(database)/documents/teamMembers/$(callerUserData().teamMemberId)).data) &&
        ['maintenance_lead', 'maintenance'].hasAny([
          get(/databases/$(database)/documents/teamMembers/$(callerUserData().teamMemberId)).data.role
        ]);
    }

    function canManageTasks(accountId) {
      return canManageAccount(accountId) ||
        hasAnyRole(accountId, ['maintenance_lead', 'maintenance']) ||
        callerHasTaskManagementRole(accountId) ||
        callerLinkedTeamMemberHasTaskManagementRole(accountId);
    }

    function scopedRecordAccountId(data) {
      return ('accountId' in data)
        ? data.accountId
        : (('userId' in data) ? data.userId : '');
    }

    function canReadHomeownerWorkRequestRecord(data) {
      return isAuthenticated() &&
        ('accountId' in data) &&
        ('propertyId' in data) &&
        isHomeownerAccountOwner(data.accountId) &&
        exists(/databases/$(database)/documents/properties/$(data.propertyId)) &&
        scopedRecordAccountId(
          get(/databases/$(database)/documents/properties/$(data.propertyId)).data
        ) == data.accountId;
    }

    function canManageFamilyMemberRole(userId) {
      return isAuthenticated() &&
        userId != request.auth.uid &&
        exists(/databases/$(database)/documents/users/$(userId)) &&
        canManageAccount(get(/databases/$(database)/documents/users/$(userId)).data.accountId) &&
        request.resource.data.diff(resource.data).changedKeys().hasOnly([
          'firstName',
          'lastName',
          'title',
          'phone',
          'address',
          'image',
          'role',
          'updatedAt'
        ]);
    }

    function canManageLinkedTeamMemberProfile(userId) {
      return isAuthenticated() &&
        userId != request.auth.uid &&
        exists(/databases/$(database)/documents/users/$(userId)) &&
        ('teamMemberId' in get(/databases/$(database)/documents/users/$(userId)).data) &&
        exists(/databases/$(database)/documents/teamMembers/$(get(/databases/$(database)/documents/users/$(userId)).data.teamMemberId)) &&
        (
          (
            'accountId' in get(/databases/$(database)/documents/teamMembers/$(get(/databases/$(database)/documents/users/$(userId)).data.teamMemberId)).data &&
            canManageAccount(get(/databases/$(database)/documents/teamMembers/$(get(/databases/$(database)/documents/users/$(userId)).data.teamMemberId)).data.accountId)
          ) ||
          (
            'userId' in get(/databases/$(database)/documents/teamMembers/$(get(/databases/$(database)/documents/users/$(userId)).data.teamMemberId)).data &&
            canManageAccount(get(/databases/$(database)/documents/teamMembers/$(get(/databases/$(database)/documents/users/$(userId)).data.teamMemberId)).data.userId)
          )
        ) &&
        request.resource.data.diff(resource.data).changedKeys().hasOnly([
          'firstName',
          'lastName',
          'title',
          'phone',
          'address',
          'image',
          'role',
          'updatedAt'
        ]);
    }

    function canReadTeamMemberResource() {
      return ('accountId' in resource.data && canReadAccount(resource.data.accountId)) ||
        ('userId' in resource.data && canReadAccount(resource.data.userId));
    }

    function canManageTeamMemberResource() {
      return ('accountId' in resource.data && canManageAccount(resource.data.accountId)) ||
        ('userId' in resource.data && canManageAccount(resource.data.userId));
    }

    function canCreateTeamMemberResource() {
      return (
        ('accountId' in request.resource.data) &&
        canManageAccount(request.resource.data.accountId) &&
        canWriteTeamMemberData(request.resource.data.accountId, request.resource.data)
      ) ||
        (
          ('userId' in request.resource.data) &&
          canManageAccount(request.resource.data.userId) &&
          canWriteTeamMemberData(request.resource.data.userId, request.resource.data)
        );
    }

    // Family membership helper for read-only access paths.
    function isFamilyMember(accountId) {
      return isAuthenticated() &&
        (
          request.auth.uid == accountId ||
          get(/databases/$(database)/documents/familyAccounts/$(accountId)).data.ownerId == request.auth.uid ||
          request.auth.uid in get(/databases/$(database)/documents/familyAccounts/$(accountId)).data.memberIds
        );
    }

    match /users/{userId} {
      allow read: if isOwner(userId);
      allow update: if
        !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'maintley_role',
          'registrationStatus',
          'registrationMode',
          'emailVerifiedAt'
        ]) && (
          (isOwner(userId) && clientSubscriptionUpdateIsSafe()) ||
          canManageFamilyMemberRole(userId) ||
          canManageLinkedTeamMemberProfile(userId)
        );
      allow delete: if isOwner(userId);
      allow create: if isAuthenticated() && request.auth.uid == userId &&
        request.resource.data.email == request.auth.token.email &&
        request.resource.data.registrationStatus == 'pending_email_verification' &&
        clientInitialSubscriptionIsSafe(request.resource.data);
    }

    match /propertyGroups/{groupId} {
      allow read: if isAuthenticated() &&
        ('accountId' in resource.data) &&
        canReadAccount(resource.data.accountId);
      allow create: if isAuthenticated() &&
        ('accountId' in request.resource.data) &&
        canManageAccount(request.resource.data.accountId) &&
        canUsePropertyGroups(request.resource.data.accountId);
      allow update, delete: if isAuthenticated() &&
        ('accountId' in resource.data) &&
        canManageAccount(resource.data.accountId) &&
        canUsePropertyGroups(resource.data.accountId);
    }

    match /properties/{propertyId} {
      allow read: if isAuthenticated() &&
        ('accountId' in resource.data) &&
        canReadAccount(resource.data.accountId);
      allow create: if isAuthenticated() &&
        ('accountId' in request.resource.data) &&
        canManageAccount(request.resource.data.accountId) &&
        hasCorePlanForResources(request.resource.data.accountId) &&
        propertyCreateRespectsResidentPlan(request.resource.data.accountId) &&
		propertyCreateRespectsTaxonomyPlan(request.resource.data.accountId) &&
        currentPropertyCount(request.resource.data.accountId) < maxPropertiesForAccount(request.resource.data.accountId) &&
        hasPropertyCounterCreateIncrement(request.resource.data.accountId);
      allow update: if isAuthenticated() &&
        ('accountId' in resource.data) &&
        canManageAccount(resource.data.accountId) &&
		propertyWriteRespectsResidentPlan(resource.data.accountId) &&
		propertyUpdateRespectsTaxonomyPlan(resource.data.accountId);
      allow delete: if isAuthenticated() &&
        ('accountId' in resource.data) &&
        canManageAccount(resource.data.accountId) &&
        hasPropertyCounterDeleteDecrement(resource.data.accountId);
    }

    function propertySpaceDataIsValid(data) {
      return data.keys().hasAll([
          'accountId',
          'propertyId',
          'name',
          'type',
          'isArchived',
          'source',
          'createdBy',
          'updatedBy',
          'createdAt',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'accountId',
          'propertyId',
          'name',
          'type',
          'notes',
          'sortOrder',
		  'generationKey',
          'isArchived',
          'source',
          'createdBy',
          'updatedBy',
          'createdAt',
          'updatedAt'
        ]) &&
        data.accountId is string &&
        data.propertyId is string &&
        data.name is string &&
        data.name.size() > 0 &&
        data.name.size() <= 80 &&
        data.type in [
          'interior',
          'utility',
          'storage',
          'exterior',
          'grounds',
          'amenity',
          'other'
        ] &&
        (!('notes' in data) || (data.notes is string && data.notes.size() <= 500)) &&
        (!('sortOrder' in data) || (data.sortOrder is number && data.sortOrder >= 0)) &&
		(!('generationKey' in data) || (data.generationKey is string && data.generationKey.size() > 0 && data.generationKey.size() <= 80)) &&
		(!('generationKey' in data) || data.source in ['property_profile', 'setup_assistant']) &&
		(!(data.source in ['property_profile', 'setup_assistant']) || ('generationKey' in data)) &&
        data.isArchived is bool &&
        data.source in [
          'manual',
		  'property_profile',
		  'setup_assistant',
          'document_review',
          'intelligence_review',
          'migration'
        ] &&
        data.createdBy is string &&
        data.updatedBy is string &&
        data.createdAt is string &&
        data.updatedAt is string;
    }

    function propertySpaceMatchesProperty(data) {
      return exists(/databases/$(database)/documents/properties/$(data.propertyId)) &&
        get(/databases/$(database)/documents/properties/$(data.propertyId)).data.accountId == data.accountId;
    }

    match /propertySpaces/{spaceId} {
      allow read: if isAuthenticated() &&
        ('accountId' in resource.data) &&
        canReadAccount(resource.data.accountId);
