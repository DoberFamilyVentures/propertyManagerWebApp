        ('accountId' in resource.data) &&
        ('accountId' in request.resource.data) &&
        ('propertyId' in resource.data) &&
        ('propertyId' in request.resource.data) &&
        resource.data.accountId == request.resource.data.accountId &&
        resource.data.propertyId == request.resource.data.propertyId &&
