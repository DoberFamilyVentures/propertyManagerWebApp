    match /personalAssistantCredentials/{credentialId} {
      allow read, write: if false;
    }

    match /personalAssistantRateLimits/{rateLimitId} {
      allow read, write: if false;
    }

    match /personalAssistantAccessAudits/{auditId} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
