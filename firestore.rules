    function propertySupplyDataIsValid(data) {
      return data.keys().hasAll([
          'accountId',
          'propertyId',
          'name',
          'type',
          'isArchived',
          'source',
          'createdBy',
          'updatedBy',
          'createdAt',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'accountId',
          'propertyId',
          'name',
          'type',
          'manufacturer',
          'modelOrSku',
		  'barcodeValue',
		  'partNumber',
		  'size',
		  'details',
		  'material',
		  'voltage',
		  'mervRating',
		  'compatibility',
		  'replacementInterval',
          'notes',
          'isArchived',
          'source',
          'createdBy',
          'updatedBy',
          'createdAt',
          'updatedAt'
        ]) &&
        data.accountId is string &&
        data.propertyId is string &&
        data.name is string &&
        data.name.size() > 0 &&
        data.name.size() <= 100 &&
        data.type in [
          'filter',
          'paint_and_finish',
          'lawn_and_garden',
          'pool_and_spa',
          'electrical',
          'plumbing',
          'hardware',
          'cleaning',
