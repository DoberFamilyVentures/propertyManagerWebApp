STRIPE_PORTFOLIO_MONTHLY_PRICE_ID=
# @maintley-env scope=functions delivery=github-variable environments=development,production required=true source=REACT_APP_STRIPE_PORTFOLIO_ANNUAL_PRICE_ID
STRIPE_PORTFOLIO_ANNUAL_PRICE_ID=
# Functions rollout controls ------------------------------------------------
# @maintley-env scope=functions delivery=github-variable environments=development,production required=false developmentDefault=false productionDefault=true localDefault=false
REQUIRE_EMAIL_VERIFICATION=false
# @maintley-env scope=functions delivery=github-variable environments=development,production required=false developmentDefault=false productionDefault=true
ENABLE_HOMEOWNER_PLUS_PRODUCT_TRIAL=false
