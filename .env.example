REACT_APP_STRIPE_CUSTOMER_PORTAL_URL=
# @maintley-env scope=web delivery=github-variable environments=development,production required=true
REACT_APP_STRIPE_HOMEOWNER_PLUS_MONTHLY_PRICE_ID=
# @maintley-env scope=web delivery=github-variable environments=development,production required=true
REACT_APP_STRIPE_HOMEOWNER_PLUS_ANNUAL_PRICE_ID=
# @maintley-env scope=web delivery=github-variable environments=development,production required=true
REACT_APP_STRIPE_PROPERTY_MONTHLY_PRICE_ID=
# @maintley-env scope=web delivery=github-variable environments=development,production required=true
REACT_APP_STRIPE_PROPERTY_ANNUAL_PRICE_ID=
# @maintley-env scope=web delivery=github-variable environments=development,production required=true
REACT_APP_STRIPE_PORTFOLIO_MONTHLY_PRICE_ID=
# @maintley-env scope=web delivery=github-variable environments=development,production required=true
REACT_APP_STRIPE_PORTFOLIO_ANNUAL_PRICE_ID=
# Browser integrations and URLs ---------------------------------------------
# @maintley-env scope=web delivery=github-variable environments=development,production required=false
REACT_APP_WEATHER_API_KEY=
# @maintley-env scope=web delivery=github-variable environments=development,production required=true developmentDefault=https://maintleybeta.web.app productionDefault=https://maintleyapp.com
REACT_APP_PUBLIC_WEB_URL=
# @maintley-env scope=web delivery=build-profile environments=development,production required=true developmentDefault=browser productionDefault=browser
REACT_APP_ROUTER_MODE=
# @maintley-env scope=web delivery=github-context environments=development required=false
REACT_APP_BUILD_VERSION=
# @maintley-env scope=web delivery=github-variable environments=development,production required=false productionDefault=https://play.google.com/store/apps/details?id=com.maintleyapp
REACT_APP_PLAY_STORE_URL=
# Browser rollout controls --------------------------------------------------
# @maintley-env scope=web delivery=github-variable environments=development,production required=false developmentDefault=false productionDefault=true localDefault=false
REACT_APP_REQUIRE_EMAIL_VERIFICATION=false
# @maintley-env scope=web delivery=github-variable environments=development,production required=false developmentDefault=false productionDefault=true
REACT_APP_ENABLE_HOMEOWNER_PLUS_PRODUCT_TRIAL=false
# @maintley-env scope=web delivery=github-variable environments=development,production required=false developmentDefault=false productionDefault=true
REACT_APP_ENABLE_INTERNAL_ENTITLEMENT_GRANT_ISSUANCE=false
# @maintley-env scope=web delivery=github-variable environments=development,production required=false developmentDefault=false productionDefault=true
REACT_APP_ENABLE_TRUSTED_SETUP_PLAN_ACTIVATION=false
# @maintley-env scope=web delivery=github-variable environments=development,production required=false developmentDefault=false productionDefault=true
REACT_APP_ENABLE_TRUSTED_RECURRING_TASK_WRITES=false
# @maintley-env scope=web delivery=github-variable environments=development,production required=false developmentDefault=false productionDefault=false
REACT_APP_ENABLE_COMPLIMENTARY_ACCESS_CODES=false
# @maintley-env scope=web delivery=github-variable environments=development,production required=false developmentDefault=false productionDefault=true
REACT_APP_ENABLE_TRUSTED_STORAGE_QUOTA=false
# Browser local development -------------------------------------------------
