RESEND_FEEDBACK_FROM_EMAIL=
# @maintley-env scope=functions delivery=github-variable environments=development,production required=false developmentDefault=RESEND_API_KEY productionDefault=RESEND_API_KEY
RESEND_API_KEY_SECRET_NAME=RESEND_API_KEY

