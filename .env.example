# Functions application identity --------------------------------------------
# @maintley-env scope=functions delivery=github-variable environments=development,production required=true developmentDefault=https://maintleybeta.web.app productionDefault=https://maintleyapp.com
APP_URL=
# @maintley-env scope=functions delivery=github-variable environments=development,production required=true developmentDefault=development productionDefault=production
MAINTLEY_ENVIRONMENT=
# @maintley-env scope=functions delivery=github-variable environments=development,production required=false developmentDefault=false productionDefault=false
ENTITLEMENT_COMPARE_MODE=false
# @maintley-env scope=functions delivery=github-variable environments=development,production required=false developmentDefault=maintleyapp@gmail.com productionDefault=maintleyapp@gmail.com
SUPPORT_EMAIL=
# Functions email delivery --------------------------------------------------
# @maintley-env scope=functions delivery=github-variable environments=development,production required=false developmentDefault=Maintley<noreply@maintleyapp.com> productionDefault=Maintley<noreply@maintleyapp.com>
RESEND_FROM_EMAIL=
