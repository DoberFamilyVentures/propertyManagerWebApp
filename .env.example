# Maintley environment contract
#
# Every variable must have one @maintley-env declaration immediately above it.
# Real values never belong in this file. The automation uses this contract to
# organize the ignored root .env control file, generate matching .env.local,
# .env.beta, and .env.prod targets for the app and Functions, synchronize
# GitHub variables, and verify Firebase Secret Manager requirements.

# Browser Firebase ----------------------------------------------------------
# @maintley-env scope=web delivery=github-variable environments=development,production required=true
REACT_APP_FIREBASE_API_KEY=
# @maintley-env scope=web delivery=github-variable environments=development,production required=true
REACT_APP_FIREBASE_AUTH_DOMAIN=
# @maintley-env scope=web delivery=github-variable environments=development,production required=true
REACT_APP_FIREBASE_PROJECT_ID=
# @maintley-env scope=web delivery=github-variable environments=development,production required=true
REACT_APP_FIREBASE_STORAGE_BUCKET=
# @maintley-env scope=web delivery=github-variable environments=development,production required=true
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=
# @maintley-env scope=web delivery=github-variable environments=development,production required=true
REACT_APP_FIREBASE_APP_ID=
# Browser analytics ---------------------------------------------------------
# @maintley-env scope=web delivery=github-variable environments=development,production required=false
REACT_APP_FIREBASE_MEASUREMENT_ID=
# @maintley-env scope=web delivery=github-variable environments=development,production required=false developmentDefault=false productionDefault=true localDefault=false
REACT_APP_ENABLE_ANALYTICS=false
# @maintley-env scope=web delivery=github-variable environments=development,production required=false developmentDefault=false productionDefault=false
REACT_APP_ANALYTICS_DEBUG=false
# @maintley-env scope=web delivery=local-only environments=development required=false developmentDefault=false
REACT_APP_FIRESTORE_FORCE_LONG_POLLING=false
# @maintley-env scope=web delivery=github-variable environments=development,production required=false
REACT_APP_FIREBASE_WEB_PUSH_VAPID_KEY=
# Browser Stripe ------------------------------------------------------------
# @maintley-env scope=web delivery=github-variable environments=development,production required=true
REACT_APP_STRIPE_PUBLIC_KEY=
